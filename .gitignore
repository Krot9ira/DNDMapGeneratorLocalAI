# Build
/build/
/bin/
/dist/
*.obj
*.pdb
*.ilk
*.exp
*.lib

# Generated maps. Keep the folder, not what lands in it.
/output/*
!/output/.gitkeep

# The tile library for the tiled render backend: an SQLite database and a tree
# of PNGs, rebuilt from styles/ by tools/tilegen.py. It is generated art, it is
# large, and it is machine-local - the repository holds the recipe, not the
# output of running it.
/assets/

# Scratch. Masks, sheets, cut tiles, contact sheets, anything a tool needed to
# write down on the way to a result. Safe to delete at any time.
/temp/

# Python
__pycache__/
*.py[cod]

# Editors and Windows
.vs/
.vscode/
.idea/
*.user
*.suo
Thumbs.db
desktop.ini

# Window layout, written by the app on every run. Machine-local.
imgui.ini

# Local machine settings. Copy config.json and edit the copy.
config.local.json
